# ─────────────────────────────────────────────────────────────────────────────
# Vault backend configuration.
#
# Generate the four secrets below with:   npm run gen:keys
# NEVER commit a real .env. NEVER ship any of these values to a client.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# The API binds to loopback only. The reverse proxy (Caddy) is the sole
# public listener. Do not change HOST to 0.0.0.0 in production.
HOST=127.0.0.1
PORT=3000

DATABASE_URL=postgresql://localhost:5432/vault_dev
TEST_DATABASE_URL=postgresql://localhost:5432/vault_test

# Signs client access tokens (HS256). 32+ random bytes, base64.
JWT_SECRET=

# Mixed into every Argon2id hash (admin password, client password, and the
# Document Master Password). An attacker with a database dump but not the
# server config cannot mount an offline attack. 32 random bytes, base64.
SERVER_PEPPER=

# Key-encryption key. Wraps every per-file data key. EXACTLY 32 bytes, base64.
# Losing this makes every stored document permanently unreadable — back it up
# somewhere that is not the same machine as the database.
STORAGE_KEK=

# Salt for hashing client IP addresses in the audit log. Raw IPs are never
# stored. 16+ random bytes, base64.
IP_HASH_SALT=

# Absolute path to the encrypted blob store. Must NOT be inside any directory
# served by the reverse proxy.
STORAGE_ROOT=./var/storage

# Upload limits (admin-only ingestion in the MVP).
MAX_UPLOAD_BYTES=104857600

# Layer-1 token lifetimes.
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

# Device request signatures: accepted clock skew, in seconds, either direction.
SIGNATURE_WINDOW_SECONDS=60

# Argon2id parameters. Calibrate on the target hardware to ~500 ms:
#   node -e "…"  or simply time a login. Higher is better.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Admin interface. Keep this on a private network — LAN, WireGuard or Tailscale.
ADMIN_ORIGIN=http://localhost:5173
ADMIN_SESSION_TTL_MINUTES=60
ADMIN_STEPUP_TTL_SECONDS=300
